{
  "name": "proto-tether-mdk-worker",
  "version": "0.1.0",
  "description": "Proto Rig Worker plugin for Tether MDK",
  "keywords": ["tether", "mdk", "proto", "bitcoin", "mining"],
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "type": "commonjs",
  "files": [
    "lib/",
    "src/",
    "mock/",
    "scripts/",
    "mdk-contract.json",
    "smoke.config.js",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mock": "node scripts/run-mock.js",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.test.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.2"
  }
}
